# Demo mode needs no paid APIs. Copy to .env and replace the example admin password.
DEMO_MODE=true
MONGODB_URI=
MONGODB_DATABASE=brandguard
MONGO_INITDB_ROOT_USERNAME=brandguard
MONGO_INITDB_ROOT_PASSWORD=ChangeMeMongo2026
# Optional local persistence: uncomment after starting Docker Compose.
# MONGODB_URI=mongodb://brandguard:ChangeMeMongo2026@localhost:27017/?authSource=admin

# Demo administrator is created on first startup. Change this password before any deployment.
DEMO_ADMIN_EMAIL=admin@brandguard.local
DEMO_ADMIN_PASSWORD=ChangeThisDemo123!

# Demo secrets are generated per process when blank. Set stable random secrets in production.
JWT_SECRET=
OTP_PEPPER=
JWT_ISSUER=brandguard-ai
SESSION_TTL_MINUTES=720
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# SMTP is optional in demo mode; codes are available from the local demo mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Frontend and secure session cookie. For separate production sites use HTTPS and SameSite=None.
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional Gemini review. Keep credentials on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Qdrant vector retrieval with local FastEmbed. Blank keeps lexical retrieval active.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=brandguard_sources
QDRANT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Local: QDRANT_URL=http://localhost:6333 (after docker compose --profile rag up -d qdrant)
